#!/usr/bin/env bash
#
# technolinator-flutter: Flutter for the `prepare` script of a repository (see docs/Repository_Config.md).
#
#   technolinator-flutter <version> [directory...]
#       Sets up the given Flutter version, runs `flutter pub get` in each directory (default: the current one) and
#       hands FLUTTER_ROOT, FLUTTER_SDK and PUB_CACHE over to cdxgen, so its Gradle run for the Android part finds them.
#       Directories are relative to the current one, which is the analysed folder, and must contain a pubspec.yaml.
#
#   technolinator-flutter --setup <version>
#       Only sets up the version and hands the variables over to cdxgen. Prints `export` statements for the
#       calling script, so that it can run Flutter on its own:  eval "$(technolinator-flutter --setup 3.44.1)"; flutter pub get
#
# The installed Flutter SDKs are read-only and shared by all analyses, but Flutter wants to write into its SDK.
# So each analysis gets an overlay in its scratch directory, which is made of symbolic links to the installed SDK,
# except for the few folders written to (see below). That costs a few kilobytes, instead of several gigabytes for a copy.
#
# Directly runs the Flutter tool, instead of the bin/flutter script of the SDK, as that one updates stamps in the SDK on every call.
set -euo pipefail

die() {
    echo "technolinator-flutter: $*" >&2
    exit 1
}

installed_versions() {
    local versions
    versions=$(ls "$sdk_root" 2>/dev/null | tr '\n' ' ' || true)
    echo "${versions:-none}"
}

# Links each entry of the source folder into the target folder, except for the ones named.
link_children() {
    local src=$1 dst=$2
    shift 2
    local entry name skip
    shopt -s dotglob nullglob
    for entry in "$src"/*; do
        name=${entry##*/}
        for skip in "$@"; do
            [[ $name == "$skip" ]] && continue 2
        done
        ln -s "$entry" "$dst/$name"
    done
    shopt -u dotglob nullglob
}

# Hands a variable over to cdxgen
register() {
    if [[ -n ${TECHNOLINATOR_ENV:-} ]]; then
        printf '%s=%s\n' "$1" "$2" >> "$TECHNOLINATOR_ENV"
    fi
}

build_overlay() {
    local src=$1 overlay=$2
    # The real folders are those Flutter or Gradle write to: the Flutter Gradle plugin is an included build of
    # the Android project, so Gradle creates .gradle, build and .kotlin in it. bin holds the launcher we replace.
    mkdir -p "$overlay/bin" "$overlay/packages/flutter_tools/gradle"
    link_children "$src" "$overlay" bin packages
    link_children "$src/bin" "$overlay/bin" flutter dart
    link_children "$src/packages" "$overlay/packages" flutter_tools
    link_children "$src/packages/flutter_tools" "$overlay/packages/flutter_tools" gradle
    link_children "$src/packages/flutter_tools/gradle" "$overlay/packages/flutter_tools/gradle" .gradle build .kotlin

    cat > "$overlay/bin/flutter" <<LAUNCHER
#!/usr/bin/env bash
# Generated by technolinator-flutter: runs the Flutter tool of the read-only SDK, working in its overlay.
# Same invocation as bin/internal/shared.sh of Flutter, without the update checks writing to the SDK.
export FLUTTER_ROOT='$overlay'
export FLUTTER_ALREADY_LOCKED=true
export CI=true
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0='*'
exec "\$FLUTTER_ROOT/bin/cache/dart-sdk/bin/dart" \\
    --packages="\$FLUTTER_ROOT/packages/flutter_tools/.dart_tool/package_config.json" \\
    "\$FLUTTER_ROOT/bin/cache/flutter_tools.snapshot" --suppress-analytics --no-version-check "\$@"
LAUNCHER
    chmod +x "$overlay/bin/flutter"

    # the launcher of the SDK for dart updates stamps in the SDK as well, the Dart SDK itself doesn't
    cat > "$overlay/bin/dart" <<LAUNCHER
#!/usr/bin/env bash
# Generated by technolinator-flutter: runs the Dart SDK of the Flutter SDK.
exec '$overlay/bin/cache/dart-sdk/bin/dart' "\$@"
LAUNCHER
    chmod +x "$overlay/bin/dart"
}

# Prepares the overlay of the version, sets $overlay
setup() {
    local version=$1
    [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "the version must be an installed stable version like 3.44.1, not '$version'"
    local src="$sdk_root/$version"
    [[ -x $src/bin/cache/dart-sdk/bin/dart ]] || die "Flutter $version is not installed, available are: $(installed_versions)"

    overlay="$scratch/flutter-$version"
    if [[ ! -x $overlay/bin/flutter ]]; then
        rm -rf "$overlay"
        build_overlay "$src" "$overlay"
    fi
    export PUB_CACHE=${PUB_CACHE:-$scratch/pub-cache}
    mkdir -p "$PUB_CACHE"

    register FLUTTER_ROOT "$overlay"
    register FLUTTER_SDK "$overlay"
    register PUB_CACHE "$PUB_CACHE"
}

# Resolves the directories, which must be inside of the analysed folder and contain a Flutter package
resolve_directories() {
    local base dir real
    base=$(pwd -P)
    for dir in "$@"; do
        [[ $dir != /* ]] || die "directories must be relative to the analysed folder: $dir"
        real=$(cd -- "$dir" 2>/dev/null && pwd -P) || die "directory not found: $dir"
        [[ $real == "$base" || $real == "$base"/* ]] || die "directory is outside of the analysed folder: $dir"
        [[ -f $real/pubspec.yaml && ! -L $real/pubspec.yaml ]] || die "directory has no pubspec.yaml: $dir"
        echo "$real"
    done
}

pub_get() {
    local dir props
    for dir in "$@"; do
        echo "technolinator-flutter: flutter pub get in $dir" >&2
        (cd -- "$dir" && "$overlay/bin/flutter" pub get)
        # Flutter writes the location of its SDK to android/local.properties, Gradle needs the Android SDK there as well
        props="$dir/android/local.properties"
        if [[ -d $dir/android && -n ${ANDROID_HOME:-} ]] && ! grep -qs '^sdk.dir=' "$props"; then
            # don't merge with a last line lacking its line break
            if [[ -s $props && -n $(tail -c 1 "$props") ]]; then
                echo >> "$props"
            fi
            printf 'sdk.dir=%s\n' "$ANDROID_HOME" >> "$props"
        fi
    done
}

main() {
    local setup_only=false
    if [[ ${1:-} == --setup ]]; then
        setup_only=true
        shift
    fi
    [[ $# -ge 1 ]] || die "usage: technolinator-flutter [--setup] <version> [directory...]"
    local version=$1
    shift

    sdk_root="${SDK_DIR:-/app/sdks}/flutter"
    scratch=${TECHNOLINATOR_SCRATCH:-}
    [[ -n $scratch && -d $scratch ]] || die "TECHNOLINATOR_SCRATCH is not set, this is meant to be run by the prepare script of a repository"

    if $setup_only; then
        [[ $# -eq 0 ]] || die "--setup takes no directories"
        setup "$version" >&2
        printf 'export FLUTTER_ROOT=%q FLUTTER_SDK=%q PUB_CACHE=%q\n' "$overlay" "$overlay" "$PUB_CACHE"
        printf 'export PATH=%q\n' "$overlay/bin:$PATH"
    else
        local resolved directories
        resolved=$(resolve_directories "${@:-.}")
        mapfile -t directories <<< "$resolved"
        setup "$version"
        pub_get "${directories[@]}"
    fi
}

main "$@"
